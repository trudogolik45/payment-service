# Статический ключ API: заголовок X-API-Key
API_KEY=dev-api-key

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Эмуляция платёжного шлюза
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

# Повторные попытки обработки сообщения: всего MAX_ATTEMPTS попыток,
# задержка перед n-й повторной попыткой = RETRY_BASE_DELAY_SECONDS * 2^(n-1)
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2

WEBHOOK_TIMEOUT_SECONDS=5
# Секрет HMAC-SHA256 подписи webhook (заголовок X-Webhook-Signature), минимум 16 символов
WEBHOOK_SECRET=change-me-webhook-secret-32-chars
# Хосты через запятую, которым разрешён webhook во внутреннюю сеть (защита от SSRF)
WEBHOOK_ALLOWED_HOSTS=webhook-sink
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_HOURS=24
# После стольких неудачных публикаций событие уходит в карантин (attempts, last_error)
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CLEANUP_INTERVAL_SECONDS=60
CONSUMER_PREFETCH_COUNT=10

# Порты на хосте (docker compose). Меняйте, если заняты.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8000
WEBHOOK_SINK_PORT=8080
